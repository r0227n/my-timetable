{
  "name": "my-timetable",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "debug": "vite --mode debug",
    "build": "tsc -b && vite build",
    "build:e2e:fake": "tsc -b && vite build --mode e2e-fake",
    "build:e2e:real": "tsc -b && vite build --mode e2e-real",
    "test": "vitest run",
    "test:e2e": "bun run build && bun run build:e2e:real && playwright test",
    "test:e2e:fake": "bun run build && bun run build:e2e:fake && E2E_ANALYSIS_MODE=fake playwright test",
    "test:watch": "vitest",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@litert-lm/core": "0.15.0",
    "@my-timetable/glm-ocr-web": "file:packages/glm-ocr-web",
    "i18next": "26.4.0",
    "i18next-resources-to-backend": "1.2.3",
    "lucide-react": "1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.12",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "jsdom": "30.0.1",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "packageManager": "bun@1.4.0"
}
